{
  "name": "aapesh-desktop",
  "productName": "AAPESH",
  "version": "2.0.0",
  "private": true,
  "author": "AAPESH",
  "description": "AAPESH Music Player for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "frontend:test": "npm --prefix frontend test",
    "frontend:build": "npm --prefix frontend run build",
    "backend:test": "python -m pytest backend/tests -q",
    "backend:package": "pyinstaller --noconfirm --clean --distpath backend/dist --workpath backend/work backend/AAPESHBackend.spec",
    "desktop:dev": "npm run frontend:build && electron .",
    "desktop:build": "npm run frontend:build && npm run backend:package",
    "desktop:package": "npm run desktop:build && electron-builder --win nsis --x64",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis portable --x64",
    "test": "npm run frontend:test && npm run backend:test"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "motion": "^13.2.0",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.aapesh.musicplayer",
    "productName": "AAPESH",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!backend/**/*",
      "!frontend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/AAPESHBackend.exe",
        "to": "backend/AAPESHBackend.exe"
      },
      {
        "from": "frontend/dist",
        "to": "frontend"
      },
      {
        "from": "assets/aapesh.ico",
        "to": "assets/aapesh.ico"
      }
    ],
    "win": {
      "icon": "assets/aapesh.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "AAPESH-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AAPESH",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "AAPESH-Portable-${arch}.${ext}"
    }
  }
}
