# Aurora Music Environment Configuration

# Backend API Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Settings (Defaults to local SQLite database)
DATABASE_URL=sqlite:///./aurora_music.db

# Cache Settings
CACHE_TTL_SECONDS=1800

# YouTube Music Authentication (Optional)
# Leave empty for unauthenticated mode (Search, Explore, Catalog, Charts, Lyrics will all work out-of-the-box).
# To enable account sync (personal playlists, ratings, subscriptions):
# Follow the Setup Wizard in Settings or run `python -m backend.auth.setup`
YTMUSIC_OAUTH_TOKEN_PATH=oauth.json
YTMUSIC_CLIENT_ID=
YTMUSIC_CLIENT_SECRET=
